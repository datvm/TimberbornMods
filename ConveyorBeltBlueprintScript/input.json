        "MechanicalNodeSpec.PowerInput": "{Power.Belt}",
        "BeltCarrierSpec.Speed": "{Id}"
      }
    },
    {
      "Template": "Templates/Corner.template.json",
      "Variants": ["Log", "Plank", "Late", "End"],
