    {
      "Template": "Templates/Belt.template.json",
      "Variants": ["Sp1", "Sp2", "Sp3", "Sp4"],
      "Output": "Buildings/Conveyors/{Id}/Belt/Belt{Id}.{Faction}.blueprint.json",
      "Set": {
