        "Belt": [
          { "Id": "TreatedPlank", "Amount": 1 },
          { "Id": "Gear", "Amount": 2 }
        ],
        "Riser": [
          { "Id": "TreatedPlank", "Amount": 1 },
          { "Id": "Gear", "Amount": 6 }
