        "BuildingSpec.ScienceCost": "{ScienceCost}",
        "TemplateSpec.TemplateName": "ConveyorBelt{Id}.Folktails",
        "PlaceableBlockObjectSpec.ToolGroupId": "{ToolGroupId}",
        "PlaceableBlockObjectSpec.ToolOrder": "{ToolOrder.Belt}",
