{
  "OutputRoot": "../ConveyorBelt/Root",
  "Variants": {
    "Log": {
      "Id": "Log",
      "ItemsPerHour": 1,
      "ScienceCost": 0,
      "ToolGroupId": "ConveyorLog",
      "Cost": {
        "Belt": [
          { "Id": "Log", "Amount": 3 }
        ],
        "Riser": [
          { "Id": "Log", "Amount": 3 },
          { "Id": "Gear", "Amount": 4 }
        ]
      },
      "Power": { "Belt": 2, "RiserUp": 4, "RiserDown": 1 },
