<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" InitialTargets="ValidateJsonMod">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		<ImplicitUsings>disable</ImplicitUsings>
		<SkipCompilerExecution>true</SkipCompilerExecution>
		<SkipCopyBuildProduct>true</SkipCopyBuildProduct>
		<CopyBuildOutputToOutputDirectory>false</CopyBuildOutputToOutputDirectory>
		<DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>

		<GameModsFolder>C:\Users\lukev\OneDrive\Documents\Timberborn\Mods\</GameModsFolder>
		<ModFolder Condition="'$(ModFolder)'==''">$(GameModsFolder)$(OutputModFolderName)\</ModFolder>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="**\*.cs" />
		<None Include="**\*.cs" />
	</ItemGroup>

	<Target Name="ValidateJsonMod">
		<Error Condition="'$(OutputModFolderName)'==''" Text="OutputModFolderName was not specified" />
	</Target>

	<Target Name="CopyJsonModFiles" AfterTargets="Build">
		<ItemGroup>
			<JsonModFiles Include="$(MSBuildProjectDirectory)\**\*"
				Exclude="$(MSBuildProjectDirectory)\bin\**\*;$(MSBuildProjectDirectory)\obj\**\*;$(MSBuildProjectDirectory)\out\**\*;$(MSBuildProjectDirectory)\*.csproj;$(MSBuildProjectDirectory)\*.csproj.user;$(MSBuildProjectDirectory)\**\*.cs;$(MSBuildProjectDirectory)\*.txt" />
			<JsonBuildArtifacts Include="$(OutputPath)$(AssemblyName).*" />
		</ItemGroup>

		<Message Text="Deleting $(ModFolder)..." />
		<RemoveDir Directories="$(ModFolder)" />

		<Delete Files="@(JsonBuildArtifacts)" />

		<Message Text="Copying JSON-only mod files to $(ModFolder)..." />
		<Copy SourceFiles="@(JsonModFiles)" DestinationFiles="@(JsonModFiles->'$(ModFolder)%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>

</Project>
