<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup> <!-- dotnet tool -->
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>tmesh2glb</ToolCommandName>
		<PackageId>TMesh2Glb</PackageId>
		<AssemblyName>TMesh2Glb</AssemblyName>
		<Version>1.0.0</Version>
		<Authors>Luke Vo</Authors>
		<Company>Luke Vo</Company>
		<Description>Convert Timberborn Timbermesh models to glTF/GLB for Blender, with materials and textures resolved from game resources.</Description>
		<PackageTags>timberborn;timbermesh;glb;gltf;blender;dotnet-tool</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/datvm/TimberbornMods/tree/master/Timbermesh2Blender</PackageProjectUrl>
		<RepositoryUrl>https://github.com/datvm/TimberbornMods/tree/master/Timbermesh2Blender</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Copyright>Copyright ©2026 Luke Vo</Copyright>
		<PackageReadmeFile>Docs\README.MD</PackageReadmeFile>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="protobuf-net" Version="3.2.56" />
		<PackageReference Include="ServiceSharp" Version="3.0.0" />
		<PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
		<PackageReference Include="SharpGLTF.Toolkit" Version="1.0.6" />
		<PackageReference Include="System.CommandLine" Version="2.0.10" />
		
		<ProjectReference Include="..\BlueprintReader\BlueprintReader.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="BlueprintReader.Providers" />
		<Using Include="BlueprintReader.Specs" />
		<Using Include="Microsoft.Extensions.DependencyInjection" />
		<Using Include="ProtoBuf" />
		<Using Include="ServiceSharp" />
		<Using Include="System.Collections.Frozen" />
		<Using Include="System.CommandLine" />
		<Using Include="System.Diagnostics.CodeAnalysis" />
		<Using Include="System.Numerics" />
		<Using Include="Timbermesh2Blender.Models" />
		<Using Include="Timbermesh2Blender.Services" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Docs\README.MD">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
</Project>
